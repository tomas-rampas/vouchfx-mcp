<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework / Nullable / ImplicitUsings / TreatWarningsAsErrors all come
       from the root Directory.Build.props (mirrors the vouchfx engine repo's
       convention: per-project files do not repeat them). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Vouchfx.Mcp</AssemblyName>
    <RootNamespace>Vouchfx.Mcp</RootNamespace>
  </PropertyGroup>

  <!-- Grants the test assembly access to a small number of internal-only test seams (see
       ValidationWorkerClient.ValidateAsyncForTesting) that exist purely so a test can observe
       something a public API deliberately does not expose (e.g. a spawned worker's OS process
       ID) — without adding that observability to the public surface itself. AssemblyAttribute
       (not a bare <InternalsVisibleTo> item, which is not an MSBuild-recognised item name) is the
       standard SDK-supported way to emit an [assembly: InternalsVisibleTo(...)] attribute without
       a hand-written AssemblyInfo.cs. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Vouchfx.Mcp.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- This repo is not published yet (see README "Status"), so 0.1.0 is a
       placeholder pre-1.0 version. It is the single source of truth for the
       version this MCP server reports as serverInfo.version during the MCP
       initialize handshake (see ServerIdentity.cs) — never hardcode that
       value a second time anywhere else.
       IncludeSourceRevisionInInformationalVersion is turned off so that value
       stays exactly "0.1.0" rather than gaining a non-deterministic
       "+<git-sha>" build-metadata suffix that would leak the checkout's
       commit into a protocol handshake field. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- dotnet tool packaging (REQ-011).
       PackAsTool=true + ToolCommandName make `dotnet pack` produce a tool nupkg runnable
       via `dotnet tool install -g Vouchfx.Mcp`, exposing the `vouchfx-mcp` command. The
       tool is framework-dependent (net8.0), same distribution model as the engine's own
       `vouchfx` CLI tool (src/Cli/Vouchfx.Cli/Vouchfx.Cli.csproj in the engine repo) — no
       RuntimeIdentifiers, no self-contained publish; unlike that project this one carries
       no Aspire.AppHost.Sdk, so OutputType=Exe already implies IsPublishable=true by
       default and nothing needs re-enabling.
       IsPackable=true overrides the root Directory.Build.props default (IsPackable=false,
       "not packable by default... src/Vouchfx.Mcp will opt in once packaged" — this IS
       that opt-in). tests/Vouchfx.Mcp.Tests never sets PackAsTool and tests/Directory.Build.props
       independently keeps IsPackable=false there, so only this one project packs.

       PACKAGE VERSION vs PROTOCOL VERSION — deliberately decoupled:
       <Version> above (0.1.0) is pinned as the single source of truth for serverInfo.version
       (McpServerSkeletonTests.Initialize_ReportsConfiguredServerNameAndVersion hardcodes
       "0.1.0" a second time specifically to catch any edit to that property) and MUST NOT
       change as a side effect of packaging. NuGet's Pack task otherwise derives the nupkg
       version from <Version> when <PackageVersion> is unset, which would entangle the two.
       <PackageVersion> is therefore set explicitly and independently below, guarded by a
       Condition so the release workflow can still override it per-tag via
       `-p:PackageVersion=<semver-from-tag>` (mirroring the engine CLI's `-p:Version=$VERSION`
       pattern) without ever touching <Version>/serverInfo.version. The chosen default,
       0.1.0-alpha.1, is the fleet's established prerelease shape (engine: 1.0.0-alpha.x) for
       "not yet published" (README "Status": "not yet published") — a bare local
       `dotnet pack` (no -p:PackageVersion) therefore already yields a correctly-shaped
       initial prerelease rather than a bare "1.0.0" that would misrepresent maturity. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>vouchfx-mcp</ToolCommandName>
    <PackageId>Vouchfx.Mcp</PackageId>
    <PackageVersion Condition="'$(PackageVersion)' == ''">0.1.0-alpha.1</PackageVersion>
    <Authors>vouchfx</Authors>
    <Company>vouchfx</Company>
    <Description>Local stdio Model Context Protocol (MCP) server for AI coding agents, wrapping the packaged vouchfx end-to-end integration-testing CLI. Advertises sixteen tools — validate_suite, list_step_types, describe_step_type, search_docs, plan_coverage, scaffold_suite, run_suite, explain_run, diagnose_run, explain_diagnostic, get_schema, normalize_suite, get_run_events, get_run_status, cancel_run, list_runs — plus a vendored-documentation MCP resource pair and a per-code diagnostic catalogue resource, so an agent can validate, normalize, and scaffold .e2e.yaml suites, browse the step-type catalogue and the language's own JSON Schema, plan a suite set's coverage and gap findings, run suites with a taxonomy-faithful verdict, poll, list and gracefully cancel those runs, diagnose a run's JSON Lines event stream, page that stream's raw events, obtain Fail-only Healer patch proposals, and look up any VFX-* code's meaning and fix without shelling out to vouchfx and parsing its output by hand. The server is strictly read-only: it never writes, modifies, or deletes a suite file.</Description>
    <PackageReadmeFile>PACKAGE_README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/tomas-rampas/vouchfx-mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/tomas-rampas/vouchfx-mcp</PackageProjectUrl>
    <PackageTags>mcp;model-context-protocol;vouchfx;e2e-testing</PackageTags>
    <PackageReleaseNotes>Initial prerelease packaging. The server is feature-complete (all sixteen tools + the vendored-document and diagnostic-catalogue resources), pinned to vouchfx engine ENGINE_PIN v1.0.0-rc.4; this package itself has not yet had a tagged release published to NuGet.org.</PackageReleaseNotes>
    <!-- Deterministic, reproducible packaging — mirrors the engine CLI project. -->
    <ContinuousIntegrationBuild Condition="'$(CI)'=='true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- NuGet package README — rendered as the package page body on nuget.org
       (PackageReadmeFile above). Kept package-focused and separate from the
       repository README, which targets contributors. Mirrors the engine CLI project. -->
  <ItemGroup>
    <None Include="PACKAGE_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- ModelContextProtocol: the official C# SDK (github.com/modelcontextprotocol/csharp-sdk),
       exact-pinned per repo convention (no wildcards). 1.4.1 is the latest STABLE release
       (published 2026-07-09) — the SDK reached 1.0 GA some time ago; a 2.0.0-preview.* line
       also exists on NuGet but is pre-release, so the stable line is used here instead.
       Microsoft.Extensions.Hosting is pinned to the exact version ModelContextProtocol itself
       depends on (see its nuspec), so restore never needs to reconcile two different asks for
       the same transitive package. -->
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>

  <!-- YamlDotNet 18.1.0, JsonSchema.Net 9.4.0 — both exact-pinned, no wildcards.

       THE POLICY, which is what this comment exists to state: YamlDotNet tracks the version the
       vouchfx ENGINE repo pins, because fleet consistency is a correctness property here.
       validate_suite must parse YAML with the same library version a real `vouchfx` run does, or a
       suite's verdict can diverge from the engine's on YAML scalar resolution alone — `yes`, `007`,
       a sexagesimal-looking string. normalize_suite raises the stakes: its output is text a host is
       invited to write over the author's file, so a resolution difference would be baked into the
       file rather than merely reported.

       THE PROVENANCE, stated honestly rather than as a stale number: this repository cannot verify
       the engine's current pin from anything it contains. `vendored/` carries the engine's composed
       schema and docs at the pinned commit, not its Directory.Packages.props, and ENGINE_PIN names a
       commit rather than a dependency set. An earlier version of this comment asserted the engine
       pinned YamlDotNet 16.3.0 while this project pinned 18.1.0 — a claim nothing here could check,
       and one that had gone stale. So: when advancing YamlDotNet, read the engine repo's
       Directory.Packages.props at the pinned commit and match it; do not trust a version written
       down here.

       JsonSchema.Net is deliberately NOT held to that policy — it is a validation-side dependency
       whose output this repository already normalises. 9.3.0 (Dependabot #12) added a generic error
       message to every composite/applicator schema keyword (properties, items, allOf, the if/then
       pairing's own combined result, …) whenever it fails only because one of its own subschemas
       failed; previously only the genuinely-failing LEAF keyword (e.g. required) carried a message
       at all. Those roll-ups are noise SuiteValidator.CollectSchemaErrors filters, on top of the
       "if" discriminator noise it already filtered — see SuiteValidator's remarks. That filtering is
       what makes the version divergence tolerable, and it is pinned by the suppression tests; a
       further bump means re-checking them, not just the build. -->
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!-- System.Text.Encoding.CodePages 8.0.0 — first-party Microsoft, exact-pinned (no wildcards),
       aligned to the net8.0 runtime. Needed only so VouchfxCliProcessRunner can DECODE the engine
       CLI's redirected stdout with the Windows CONSOLE OUTPUT code page (issue #70): a .NET child
       writes its redirected stdout in GetConsoleOutputCP()'s code page, and on a non-65001 console
       that is an OEM page (852, 437, 850, …) or an ANSI page (1252, …) that the in-box runtime does
       NOT provide an Encoding for — Encoding.GetEncoding(852) throws NotSupportedException without
       this provider (measured). Registered lazily by that runner's ResolveEngineOutputEncoding.
       This is a DECODE-side dependency only; nothing here changes how this server ENCODES its own
       JSON-RPC stdout, which stays untouched. -->
  <ItemGroup>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <!-- Microsoft.Extensions.FileSystemGlobbing 10.0.10 — first-party Microsoft, exact-pinned (no
       wildcards), and deliberately the SAME version band as Microsoft.Extensions.Hosting above:
       both come out of the dotnet/runtime extensions repo on a single release train, so pinning one
       to 10.0.10 and the other to, say, 8.0.0 would make restore reconcile two asks for the same
       shared dependencies. The package multi-targets net8.0 (among others), so this net8.0 project
       consumes it directly rather than through a compatibility shim.

       Used by exactly one type: Run/SuitePathExpander, for US-S3-02's `paths` glob expansion
       (`e2e/checkout/**`). It was preferred over a hand-rolled matcher for the reason a glob is
       always worth outsourcing — `**` semantics, per-segment pruning and cross-platform separator
       handling are easy to get subtly wrong, and a subtly wrong matcher here decides WHICH suites a
       run covers. It is a pure pattern-matching library: it enumerates directories and returns
       relative paths, and every path it produces still goes through the identical safety chain a
       single `path` does (leading-dash refusal, workspace rebase, UNC/containment, pre-flight
       validation), so it is never trusted as a security boundary. See SuitePathExpander's remarks. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.10" />
  </ItemGroup>

  <!-- Ship the repo-root ENGINE_PIN alongside the built executable so
       EnginePin.Load can find it via AppContext.BaseDirectory without
       assuming a source-checkout layout at run time.
       Pack="false": a Content item defaults to Pack="true" once IsPackable=true (above),
       which would additionally stuff a redundant content/ENGINE_PIN +
       contentFiles/any/net8.0/ENGINE_PIN + a <contentFiles> nuspec block into the nupkg —
       dead weight for a DotnetTool package, since that PackageReference-style
       "contentFiles" delivery mechanism is never consulted for a tool install. The copy
       that actually matters — tools/net8.0/any/ENGINE_PIN, beside the entry DLL — comes
       from CopyToOutputDirectory flowing into the Publish step that PackAsTool packs, which
       is entirely independent of Pack/PackagePath. Verified by re-packing and inspecting
       the nupkg after adding this. -->
  <ItemGroup>
    <Content Include="..\..\ENGINE_PIN" Link="ENGINE_PIN" CopyToOutputDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>

  <!-- Embed the byte-exact vendored engine artefacts (see ../../vendored/README.md
       and ../../scripts/sync-vendored.ps1) straight into the assembly manifest,
       rather than shipping them as loose Content files: the validate_suite and
       search_docs tool handlers (later todos) then read them via
       Assembly.GetManifestResourceStream, which works identically whether this
       assembly is run from a source checkout or installed as the packaged
       `Vouchfx.Mcp` dotnet tool — there is no loose-file path to get wrong
       either way. LogicalName pins the exact manifest resource name explicitly
       rather than relying on the SDK's folder-derived default (which would be
       ambiguous/fragile for files included from outside this project's own
       directory); Link only affects how the file is displayed in an IDE's
       Solution Explorer and has no effect on the embedded resource name. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\vendored\composed-schema.v1.json"
                       LogicalName="Vouchfx.Mcp.Vendored.composed-schema.v1.json"
                       Link="Vendored\composed-schema.v1.json" />
    <EmbeddedResource Include="..\..\vendored\language-reference.md"
                       LogicalName="Vouchfx.Mcp.Vendored.language-reference.md"
                       Link="Vendored\language-reference.md" />
    <EmbeddedResource Include="..\..\vendored\recipes.md"
                       LogicalName="Vouchfx.Mcp.Vendored.recipes.md"
                       Link="Vendored\recipes.md" />
  </ItemGroup>

  <!-- Embed the docs/errors/VFX-*.md diagnostic catalogue pages (US-S1-05), one per
       Contracts/VfxCodeCatalogue.All entry — same embedding discipline as the vendored engine
       artefacts above (Assembly.GetManifestResourceStream, explicit LogicalName, never a loose
       file read from disk), so explain_diagnostic and the vouchfx-docs:///errors/{code} resource
       both work identically from a source checkout or the packaged dotnet tool. LogicalName follows
       the "Vouchfx.Mcp.Errors.<CODE>.md" convention DiagnosticPageRepository.EmbeddedResourceNameFor
       derives programmatically from each catalogue entry's own Code — the two must never drift, and
       DiagnosticPageRepositoryTests / VfxCodeCatalogueTests both fail loudly if a page is added here
