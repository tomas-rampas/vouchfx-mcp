<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework / Nullable / ImplicitUsings / TreatWarningsAsErrors all come
       from the root Directory.Build.props (mirrors the vouchfx engine repo's
       convention: per-project files do not repeat them). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Vouchfx.Mcp</AssemblyName>
    <RootNamespace>Vouchfx.Mcp</RootNamespace>
  </PropertyGroup>

  <!-- Grants the test assembly access to a small number of internal-only test seams (see
       ValidationWorkerClient.ValidateAsyncForTesting) that exist purely so a test can observe
       something a public API deliberately does not expose (e.g. a spawned worker's OS process
       ID) — without adding that observability to the public surface itself. AssemblyAttribute
       (not a bare <InternalsVisibleTo> item, which is not an MSBuild-recognised item name) is the
       standard SDK-supported way to emit an [assembly: InternalsVisibleTo(...)] attribute without
       a hand-written AssemblyInfo.cs. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Vouchfx.Mcp.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- This repo is not published yet (see README "Status"), so 0.1.0 is a
       placeholder pre-1.0 version. It is the single source of truth for the
       version this MCP server reports as serverInfo.version during the MCP
       initialize handshake (see ServerIdentity.cs) — never hardcode that
       value a second time anywhere else.
       IncludeSourceRevisionInInformationalVersion is turned off so that value
       stays exactly "0.1.0" rather than gaining a non-deterministic
       "+<git-sha>" build-metadata suffix that would leak the checkout's
       commit into a protocol handshake field. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- ModelContextProtocol: the official C# SDK (github.com/modelcontextprotocol/csharp-sdk),
       exact-pinned per repo convention (no wildcards). 1.4.1 is the latest STABLE release
       (published 2026-07-09) — the SDK reached 1.0 GA some time ago; a 2.0.0-preview.* line
       also exists on NuGet but is pre-release, so the stable line is used here instead.
       Microsoft.Extensions.Hosting is pinned to the exact version ModelContextProtocol itself
       depends on (see its nuspec), so restore never needs to reconcile two different asks for
       the same transitive package. -->
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
  </ItemGroup>

  <!-- YamlDotNet + JsonSchema.Net: exact-pinned to the SAME versions the vouchfx engine repo
       itself pins (D:\src\github\vouchfx\Directory.Packages.props: YamlDotNet 16.3.0,
       JsonSchema.Net 9.2.1), not the latest NuGet releases (YamlDotNet 18.1.0 and
       JsonSchema.Net 9.3.0 at time of writing) — fleet consistency: validate_suite must parse
       YAML and evaluate the embedded composed schema with the exact same library versions the
       real engine uses, so a suite's verdict here never diverges from what a real `vouchfx`
       run would report because of a YAML-scalar-resolution or JSON-Schema-evaluation
       difference between library versions. -->
  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="JsonSchema.Net" Version="9.2.1" />
  </ItemGroup>

  <!-- Ship the repo-root ENGINE_PIN alongside the built executable so
       EnginePin.Load can find it via AppContext.BaseDirectory without
       assuming a source-checkout layout at run time. -->
  <ItemGroup>
    <Content Include="..\..\ENGINE_PIN" Link="ENGINE_PIN" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Embed the byte-exact vendored engine artefacts (see ../../vendored/README.md
       and ../../scripts/sync-vendored.ps1) straight into the assembly manifest,
       rather than shipping them as loose Content files: the validate_suite and
       search_docs tool handlers (later todos) then read them via
       Assembly.GetManifestResourceStream, which works identically whether this
       assembly is run from a source checkout or installed as the packaged
       `Vouchfx.Mcp` dotnet tool — there is no loose-file path to get wrong
       either way. LogicalName pins the exact manifest resource name explicitly
       rather than relying on the SDK's folder-derived default (which would be
       ambiguous/fragile for files included from outside this project's own
       directory); Link only affects how the file is displayed in an IDE's
       Solution Explorer and has no effect on the embedded resource name. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\vendored\composed-schema.v1.json"
                       LogicalName="Vouchfx.Mcp.Vendored.composed-schema.v1.json"
                       Link="Vendored\composed-schema.v1.json" />
    <EmbeddedResource Include="..\..\vendored\language-reference.md"
                       LogicalName="Vouchfx.Mcp.Vendored.language-reference.md"
                       Link="Vendored\language-reference.md" />
    <EmbeddedResource Include="..\..\vendored\recipes.md"
                       LogicalName="Vouchfx.Mcp.Vendored.recipes.md"
                       Link="Vendored\recipes.md" />
  </ItemGroup>

</Project>
