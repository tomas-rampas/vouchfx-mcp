<Project>
  <!-- Directory.Build.props — shared MSBuild properties for every project in this
       solution. MSBuild auto-imports the nearest Directory.Build.props found by
       walking up from each project directory; per-project .csproj files
       deliberately omit these settings so there is exactly one place to change
       them. Mirrors the vouchfx engine repo's own Directory.Build.props. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <!-- Not packable by default. src/Vouchfx.Mcp will opt in (IsPackable=true)
         once it is packaged as the `Vouchfx.Mcp` dotnet tool in a later todo. -->
    <IsPackable>false</IsPackable>

    <!-- NuGet lock files (issue #79). Direct PackageReferences across this solution are
         already exact-pinned (see the per-package rationale comments in
         src/Vouchfx.Mcp/Vouchfx.Mcp.csproj — YamlDotNet fleet-parity, JsonSchema.Net's
         deliberate divergence), but nothing pinned the TRANSITIVE closure: a hijacked or
         silently-bumped transitive package could still slip into a restore unnoticed.
         RestorePackagesWithLockFile=true makes every project restore produce/consume a
         packages.lock.json recording the resolved graph (direct and transitive) by exact
         version and content hash.
         DELIBERATELY NOT Central Package Management (CPM/Directory.Packages.props): CPM's
         value is enforcing one version per package NAME across MULTIPLE projects that each
         consume it — this repo has exactly one product project (src/Vouchfx.Mcp), so there
         is no cross-project version-consistency problem for CPM to solve, and it would buy
         nothing lock files do not already give here. Lock files alone deliver the
         reproducibility/integrity property this issue asks for.
         Locked mode (RestoreLockedMode=true, which FAILS restore with NU1004 on any drift
         from the committed lock file) is applied ONLY in CI, at the individual restore
         call sites in .github/workflows/build.yml and release.yml — never here — so a
         local `dotnet restore` after an intentional package bump regenerates the lock file
         instead of failing. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- NuGetAudit (issue #79): scan restored packages against the NuGet Audit advisory
         source on every restore, for BOTH direct and transitive packages (AuditMode=all —
         the default, "direct", would leave the very transitive closure this issue exists
         to pin unaudited). NuGetAudit=true itself only RESTATES the SDK default (audit-on-
         restore has been the default since NuGet 6.8 / .NET SDK 8.0.100 — NOT since 6.0.4xx,
         which predates the feature entirely) — it is written here explicitly as DEFENSIVE
         PINNING, so a future SDK changing that default cannot silently turn this repo's
         audit off, the same reasoning as every other exact-pinned property in this file.
         TreatWarningsAsErrors=true above (belt-and-braces with -warnaserror in CI) means a
         NuGetAudit finding fails RESTORE — audit warnings (NU1900-NU1905) are emitted and
         escalated during RESTORE, a separate and earlier step than the build in both CI
         pipelines, not the build step itself. This is FAIL-CLOSED BY DESIGN: a newly
         published advisory against a package already in the lock file will fail CI the next
         time restore evaluates audit data, even with no source change on this repo's part.
         That is the intended behaviour, not flakiness — do not suppress an audit warning
         without recording why in a comment beside the suppression.
         A SEPARATE, INFRASTRUCTURE failure mode rides the same warnings-as-errors elevation
         and must not be mistaken for an advisory: NU1900 is also the code NuGet uses when it
         cannot REACH the audit source at all (network failure, endpoint down) — that is a
         connectivity failure being reported as fail-closed, not a vulnerability finding, and
         the fix is retrying restore or investigating connectivity, never suppressing the
         warning. (NU1905 is the odd one in the range: it reports a MISCONFIGURED
         <NuGetAuditSources> item, not an advisory or a connectivity failure — this project
         declares no <NuGetAuditSources> at all, so NU1905 is unreachable here today, but the
         code is named alongside the rest for whoever widens the range's coverage next.) Two
         sanctioned escape hatches exist if either failure mode must be unblocked
         deliberately: NuGetAuditSuppress (per-advisory allowlist by ID, available from NuGet
         6.11 / SDK 8.0.400 — exactly this repo's global.json floor) to acknowledge one
         specific advisory with a reason recorded beside it, or WarningsNotAsErrors to
         downgrade the NU190x code range back to a warning without disabling audit entirely.
         Neither is used today; reach for NuGetAuditSuppress first if one ever is.
         A DEDICATED audit-only pipeline — a second CI job or step running restore with
         WarningsNotAsErrors applied just to the NU190x range, so an advisory would warn
         without blocking the build/test/pack pipeline — was considered and rejected: this is
         a single-product-project repo with one restore graph to trust, and splitting audit
         enforcement into its own soft-fail lane would only buy a way to ship past a known
         advisory unnoticed, which is the opposite of what issue #79 asks for. One fail-closed
         pipeline stays the whole policy. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <!-- GenerateDocumentationFile (issue #49). Turned on repo-wide — both src/ AND tests/, since the
       three defects below landed in both trees — because without it the C# compiler never PARSES an
       XML doc comment at all, so -warnaserror (TreatWarningsAsErrors above) has nothing to elevate:
       the whole CS157x/CS1570 structural-XML diagnostic family is silently unreachable.
       What that blindness cost, concretely, on the rc.4 repin branch — all three built clean under
       -warnaserror before a human or Copilot caught them by eye: an orphaned </remarks> running into
       a second <summary> in SuiteValidator.cs; the identical shape in
       RealValidateAgainstPinnedCliTests.cs; and two consecutive <remarks> blocks on one member in
       DocSearchService.cs. Most XML-doc tooling renders only the FIRST <remarks> on a member, so the
       second block — the one explaining why CapSnippet is internal rather than private — was
       invisible wherever it mattered. A doc comment that cannot render is worse than no comment: it
       looks maintained.
       NoWarn=CS1591 (missing doc comment on an otherwise-undocumented publicly visible member): this
       codebase has never required every public member to carry a doc comment, so CS1591 would be pure
       volume unrelated to the STRUCTURAL defects above — turning it into a build error on day one
       would block on coverage, not correctness. Deliberately NOT suppressed, and still fatal under
       -warnaserror: CS1570 (badly formed XML), CS1571 (duplicate param tag), CS1572 (param tag naming
       a parameter that does not exist), CS1573 (a real parameter with no matching param tag) and
       CS1574 (a cref that does not resolve) — exactly the family the three examples above belong to. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
