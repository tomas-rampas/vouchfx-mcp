<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework / Nullable / ImplicitUsings / TreatWarningsAsErrors / IsPackable all come
       from Directory.Build.props (root) + tests/Directory.Build.props — same inheritance as
       Vouchfx.Mcp.Tests and the StdinEofChildFixture beside it (tests/Directory.Build.props keeps
       IsPackable=false here too, so this fixture is never a candidate for `dotnet pack` and can
       never leak into the shipped Vouchfx.Mcp dotnet tool). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Vouchfx.Mcp.Tests.RunLockHolderFixture</AssemblyName>
    <RootNamespace>Vouchfx.Mcp.Tests.RunLockHolderFixture</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Unlike StdinEofChildFixture (which deliberately references nothing, because it stands in
         for the ENGINE), this fixture must hold the REAL WorkspaceRunLock and write a REAL
         FileRunRegistry entry: its whole purpose is to be the other party in a genuinely
         cross-process exclusivity test, and a fixture that re-declared the lock's open flags would
         be testing its own copy of them rather than the ones the server ships. -->
    <ProjectReference Include="..\..\src\Vouchfx.Mcp\Vouchfx.Mcp.csproj" />
  </ItemGroup>

</Project>
