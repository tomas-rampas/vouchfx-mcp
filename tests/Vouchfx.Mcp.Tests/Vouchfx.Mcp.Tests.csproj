<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework / Nullable / ImplicitUsings / TreatWarningsAsErrors / IsPackable
       all come from Directory.Build.props (root) + tests/Directory.Build.props. -->
  <PropertyGroup>
    <RootNamespace>Vouchfx.Mcp.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      Microsoft.CodeAnalysis.CSharp (the plain compiler, not the Scripting layer the engine uses):
      PublishedTerminologyGateTests.NoShippedStringLiteral_CarriesInternalPlanningVocabulary parses
      every src/**/*.cs and asserts no LITERAL token carries internal planning vocabulary. Roslyn
      rather than a regex because the distinction the gate needs — a literal versus a comment versus
      an identifier — is exactly the one a line regex cannot draw: MEASURED on this tree, the eleven
      forbidden patterns hit 851 lines under src/, 849 of them comments (this repository documents
      the story each file was written against, deliberately), and the two survivors of a
      comment-stripping pass are TextSanitiser.cs's `var isPrintableAscii = …` and the
      `if (isPrintableAscii)` beneath it — an IDENTIFIER that contains "sPrint". Note which pattern
      finds it: the BARE case-insensitive `sprint` one, never `[Ss]print[- ]\d+`, which needs a
      lower-case p and a number. Roslyn puts comments and XML docs in trivia where a token walk
      cannot see them, and never reports an identifier as a literal, so both classes are excluded by
      construction rather than by an allowlist entry that would have to exist from day one.

      The nearer alternative, and why it loses: this repository already has
      SourceGuardScan.StripCommentsAndStringLiterals, which blanks comments — but it blanks string
      literals too, which is the text this gate reads. Inverted to keep them it would still lose; its
      own remarks concede it is "not a C# lexer", it treats any `"""` as a terminator whatever the
      opening delimiter's quote count, and it knows nothing of interpolation holes — and the
      regression this gate exists to catch lives inside an interpolated string.

      Version 4.14.0: the same version the engine repository pins centrally, so the two source-census
      gates in the fleet parse with one compiler. It ships net8.0, net9.0 and netstandard2.0 assets,
      so this project's net8.0 target resolves the net8.0 one directly — no shim, and no
      netstandard2.0 compatibility hop. LanguageVersion.Preview is a CSharpParseOptions argument in
      the gate itself, not a property here; the raw and UTF-8 string forms its kind list enumerates
      need only C# 11, which net8.0's default LangVersion 12 already provides. Test-only and this
      project is not packable, so nothing reaches the shipped tool.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vouchfx.Mcp\Vouchfx.Mcp.csproj" />

    <!-- The tiny stdin-EOF-trapping child-process fixture VouchfxCliSuiteRunnerTests spawns (todo
         17, graceful teardown) — referenced so tests can name its GracefulExitMarker constant
         directly rather than duplicating that string literal, and so `dotnet build`/`dotnet test`
         on THIS project alone (not just the full solution) still produces the fixture's own built
         output at the path RepoLayout.ResolveStdinEofChildFixtureDllPath expects. -->
    <ProjectReference Include="..\StdinEofChildFixture\Vouchfx.Mcp.Tests.StdinEofChildFixture.csproj" />

    <!-- US-S3-04's cross-process run-lock holder, spawned by RealCrossProcessRunLockTests —
         referenced for the same two reasons as the fixture above: so tests can name its HeldMarker
         constant instead of duplicating a string literal, and so `dotnet build`/`dotnet test` on
         THIS project alone still produces the fixture's built output where
         RepoLayout.ResolveRunLockHolderFixtureDllPath expects it. -->
    <ProjectReference Include="..\RunLockHolderFixture\Vouchfx.Mcp.Tests.RunLockHolderFixture.csproj" />
  </ItemGroup>

  <!-- REQ-003/EDGE-003 acceptance fixtures for SuiteValidator / validate_suite: a known-good
       suite, one with an unknown step type AND a separate step missing a required field (both
       errors must surface with paths), and a deliberately malformed-YAML file (tab
       indentation). Copied to the test output directory so tests can resolve them by path. -->
  <ItemGroup>
    <None Include="Fixtures\*.e2e.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
