# .gitattributes — vouchfx-mcp line-ending and binary-marking rules.
#
# Design rationale
# ----------------
# All source and configuration text is stored as LF in the Git object store
# and checked out as LF on every platform.  This makes the dotnet format gate
# deterministic: a file written on Windows (where Git may have converted CRLF
# on checkout) still round-trips cleanly through the formatter and produces the
# same byte sequence that Linux CI will compare.
#
# Exception — .sln files: Visual Studio's solution parser has historically
# required CRLF line endings; the file is read by MSBuild on Linux without
# issue, but opening the solution in Visual Studio on Windows produces spurious
# "file modified" prompts when stored as LF.  We store .sln as CRLF to avoid
# that friction.  The dotnet CLI and GitHub Actions runners are unaffected.
#
# This file mirrors the vouchfx engine repo's .gitattributes.
#
# Usage after initial setup
# -------------------------
# Run  git add --renormalize .  once after committing this file so Git
# rewrites any existing objects that were stored with the wrong endings.

# ── Default: text files normalise to LF ──────────────────────────────────────
* text=auto eol=lf

# ── C# / .NET source ─────────────────────────────────────────────────────────
*.cs        text eol=lf
*.csx       text eol=lf
*.vb        text eol=lf
*.fs        text eol=lf
*.fsx       text eol=lf

# ── MSBuild / project system ─────────────────────────────────────────────────
*.csproj    text eol=lf
*.fsproj    text eol=lf
*.vbproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.msbuildproj text eol=lf
# .sln — stored CRLF so Visual Studio on Windows does not show spurious diffs
*.sln       text eol=crlf

# ── Configuration / data ─────────────────────────────────────────────────────
*.json      text eol=lf
*.jsonc     text eol=lf
*.xml       text eol=lf
*.xsd       text eol=lf
*.xslt      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.config    text eol=lf
*.editorconfig text eol=lf

# ── Documentation and markup ─────────────────────────────────────────────────
*.md        text eol=lf
*.txt       text eol=lf
*.rst       text eol=lf

# ── Shell / scripts ──────────────────────────────────────────────────────────
*.sh        text eol=lf
*.bash      text eol=lf
*.ps1       text eol=lf
*.psm1      text eol=lf
*.psd1      text eol=lf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# ── TypeScript / JavaScript (reserved for any future tooling) ───────────────
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf

# ── Web / CSS ─────────────────────────────────────────────────────────────────
*.html      text eol=lf
*.htm       text eol=lf
*.css       text eol=lf
*.scss      text eol=lf

# ── Git housekeeping ─────────────────────────────────────────────────────────
.gitattributes text eol=lf
.gitignore     text eol=lf
.gitmodules    text eol=lf

# ── Vendored engine artefacts — byte-exact, never renormalised ──────────────
# vendored/ holds byte-exact copies of engine-repo artefacts drift-gated by
# scripts/sync-vendored.ps1 (see vendored/README.md). They must round-trip
# through Git identically on every platform regardless of a clone's
# core.autocrlf setting, so — unlike the *.json/*.md text rules above, which
# already force eol=lf and would normally be sufficient — these paths are
# marked `binary` (equivalent to `-text -diff -merge`) as belt-and-braces:
# Git must never treat them as text worth line-ending conversion at all. This
# entry is listed after the general *.json/*.md rules above, so it wins for
# these paths (gitattributes uses last-match-wins per path).
vendored/* binary

# vendored/README.md is the one file in that directory that IS hand-authored
# prose, not a downloaded artefact — the `vendored/*` binary rule above would
# otherwise catch it too and silently disable its diff/merge in every future
# PR (a `binary` path shows as "Binary files differ" instead of a readable
# diff, and can't be three-way merged). This override is listed AFTER
# `vendored/* binary`, so per gitattributes' last-match-wins-per-path rule it
# wins for this one path and restores the normal *.md handling (eol=lf, text
# diffing, mergeable) — while the three actual artefacts immediately above
# remain `binary`.
vendored/README.md text eol=lf diff merge

# ── Binaries — never diff or merge ───────────────────────────────────────────
*.dll       binary
*.exe       binary
*.pdb       binary
*.nupkg     binary
*.snupkg    binary
*.zip       binary
*.tar       binary
*.tar.gz    binary
*.tgz       binary
*.7z        binary
*.gz        binary
*.bz2       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary -diff
*.ttf       binary
*.woff      binary
*.woff2     binary
*.pdf       binary
*.vsix      binary
